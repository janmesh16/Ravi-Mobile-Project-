# Ravi Mobile Digital Experience — Environment Configuration Template
# Copy this file to .env and replace with official production credentials/details.
# NEVER commit .env to version control.

# WhatsApp Contact (Country code without '+' followed by 10-digit mobile number)
# Example: 919823xxxxxx
VITE_WHATSAPP_NUMBER=919800000000

# Voice Calling Contact Number
VITE_SHOP_PHONE=+919800000000

# Shop Address & Landmark in Shahada, Maharashtra
VITE_SHOP_NAME="Ravi Mobile"
VITE_SHOP_CITY="Shahada"
VITE_SHOP_DISTRICT="Nandurbar"
VITE_SHOP_STATE="Maharashtra"
VITE_SHOP_PINCODE="425409"
VITE_SHOP_LANDMARK="Near Old Bus Stand / Market Yard Road"
VITE_SHOP_FULL_ADDRESS="Shop No. 12, Market Yard Road, Near Old Bus Stand, Shahada, Dist. Nandurbar, Maharashtra - 425409"

# Google Maps Navigation URL (Pin or Query link)
VITE_GOOGLE_MAPS_URL="https://maps.google.com/?q=Shahada+Nandurbar+Maharashtra"

# Business Hours
VITE_SHOP_TIMING="Monday to Sunday: 9:30 AM - 9:00 PM"
